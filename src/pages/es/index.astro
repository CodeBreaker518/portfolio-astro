---
import Layout from "../../layouts/Layout.astro";
// Components
import SocialPill from "../../components/SocialPill.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import Experience from "../../components/Experience.astro";
import Projects from "../../components/Projects.astro";
import ContactForm from "../../components/ContactForm.astro";
// Icons
import GitHubIcon from "../../assets/icons/GitHub.astro";
import LinkedInIcon from "../../assets/icons/LinkedIn.astro";
import MailIcon from "../../assets/icons/Mail.astro";
import BriefcaseIcon from "../../assets/icons/Briefcase.astro";
import CodeIcon from "../../assets/icons/Code.astro";
import MailContact from "../../assets/icons/MailContact.astro";
import FileDownload from "../../assets/icons/FileDownload.astro";

// i18n
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t('title')}
  description={t('description')}
>
  <main class="w-full">
    <SectionContainer id="top" class="pt-40 pb-28">
      <div class="grid grid-cols-1 md:grid-cols-[1.8fr_1fr] gap-y-8 md:gap-x-12 items-center">
        <!-- Hero Details -->
        <div class="order-2 md:order-1">
          <!-- Available for hire pulsing badge -->
          <div class="inline-flex items-center gap-x-2 bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 px-3 py-1 rounded-full text-xs font-semibold mb-6">
            <span class="relative flex size-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full size-2 bg-emerald-500"></span>
            </span>
            {t('hero.badge')}
          </div>
          
          <h1
            id="hero-h1"
            class="text-white text-4xl md:text-6xl font-black tracking-tight pb-3 opacity-0 translate-y-3 transition-all duration-500 ease-out">
            {t('hero.title')}
          </h1>
          <h2
            id="hero-h2"
            class="text-lg md:text-xl text-wrap leading-relaxed opacity-0 translate-y-3 transition-all duration-500 ease-out">
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-200 via-sky-300 to-emerald-200 font-bold text-xl md:text-2xl block mb-2">
              {t('hero.role')}
            </span>
            <span class="text-white font-medium">{t('hero.exp')}</span>
            <span class="text-neutral-400" set:html={t('hero.desc')} />
            <span class="text-[11px] text-neutral-500 uppercase tracking-widest block mt-4 font-semibold">
              {t('hero.loc')}
            </span>
          </h2>

          <nav
            id="hero-nav"
            class="flex gap-4 mt-8 flex-wrap text-white opacity-0 translate-y-3 transition-all duration-500 ease-out">
            <SocialPill href={t('linkedin.url')}>
              <LinkedInIcon class="size-4 lg:size-5" />
              LinkedIn
            </SocialPill>
            <SocialPill href={t('github.url')}>
              <GitHubIcon class="size-4 lg:size-5" />
              GitHub
            </SocialPill>
            <SocialPill href="mailto:diegoperezperez518@gmail.com">
              <MailIcon class="size-4 lg:size-5" />
              diegoperezperez518@gmail.com
            </SocialPill>
            <SocialPill download={t('hero.cv_filename')} href={`/${t('hero.cv_filename')}`}>
              <FileDownload class="size-4 lg:size-5" />
              {t('hero.download_cv')}
            </SocialPill>
          </nav>
        </div>

        <!-- Hero Avatar Card -->
        <div class="order-1 md:order-2 flex justify-center md:justify-end">
          <div class="relative flex justify-center items-center size-28 md:size-44">
            <!-- Glow background overlay -->
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-indigo-500 to-teal-500 opacity-20 blur-xl size-24 md:size-36"></div>
            <img
              id="hero-img"
              class="relative rounded-full size-24 md:size-36 border border-white/10 shadow-2xl transition-all duration-500 ease-out opacity-0 translate-y-3 hover:scale-105"
              src="https://i.ibb.co/yddzbPN/me.jpg"
              alt="Diego"
            />
          </div>
        </div>
      </div>
    </SectionContainer>

    <SectionContainer id="experience">
      <h2 class="text-2xl md:text-3xl text-white font-bold mb-10 flex gap-x-3 items-center">
        <BriefcaseIcon class="size-6 md:size-7" />
        {t('experience.title')}
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="projects">
      <h2 class="text-2xl md:text-3xl text-white font-bold mb-10 flex gap-x-3 items-center">
        <CodeIcon class="size-6 md:size-7" />
        {t('projects.title')}
      </h2>
      <Projects />
    </SectionContainer>

    <SectionContainer id="contact">
      <h2 class="text-2xl md:text-3xl text-white font-bold mb-10 flex gap-x-3 items-center">
        <MailContact class="size-6 md:size-7" />
        {t('contact.title')}
      </h2>
      <ContactForm />
    </SectionContainer>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const img = document.getElementById("hero-img");
        const h1 = document.getElementById("hero-h1");
        const h2 = document.getElementById("hero-h2");
        const nav = document.getElementById("hero-nav");

        const elements = [
          { el: img, delay: 100 },
          { el: h1, delay: 200 },
          { el: h2, delay: 300 },
          { el: nav, delay: 400 },
        ];

        elements.forEach(({ el, delay }) => {
          if (el) {
            setTimeout(() => {
              el.classList.remove("opacity-0", "translate-y-3");
            }, delay);
          }
        });
      });
    </script>
  </main>
</Layout>
