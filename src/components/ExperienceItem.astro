---
import { TAGS } from "../data/tags";

interface Props {
  title: string
  description: string
  link?: string
  date: string
  tags?: string[]
}

const { title, description, link, date, tags } = Astro.props
---

<div class="relative bg-white/[0.02] border border-white/[0.05] rounded-2xl p-6 backdrop-blur-md transition-all duration-300 hover:border-white/15 hover:bg-white/[0.04] hover:-translate-y-0.5 group shadow-lg shadow-black/20">
  <!-- Glowing indicator dot -->
  <div class="absolute -top-1 -left-1 flex size-2.5">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-30"></span>
    <span class="relative inline-flex rounded-full size-2.5 bg-indigo-500 border border-white/20"></span>
  </div>
  
  <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-y-2 mb-4">
    <h3 class='text-lg md:text-xl font-bold text-yellow-200 group-hover:text-white transition duration-200'>{title}</h3>
    <time class='text-[10px] md:text-xs font-semibold uppercase tracking-widest text-sky-200/80 bg-sky-950/40 border border-sky-500/10 px-2.5 py-1 rounded-full w-fit shrink-0'>{date}</time>
  </div>
  
  <!-- Description with HTML bolding support -->
  <p class='text-sm md:text-base font-normal text-neutral-300 leading-relaxed text-pretty' set:html={description} />

  <!-- Technical stack tag capsules (matches Projects style) -->
  {tags && (
    <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-white/5">
      {tags.map((tagKey) => {
        const tag = TAGS[tagKey] || { name: tagKey, class: "bg-white/5 border border-white/10 text-neutral-400", icon: null };
        return (
          <span class={`flex items-center justify-center gap-x-1 px-2.5 py-1 rounded-full text-[10px] font-medium ${tag.class} transition duration-200`}>
            {tag.icon && <tag.icon class="h-3 w-auto object-contain" />}
            {tag.name}
          </span>
        );
      })}
    </div>
  )}

  {
    link && (
      <a
        href={link}
        class='inline-flex items-center px-4 py-2 mt-4 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-200 focus:text-blue-700'>
        Learn more{' '}
        <svg
          class='w-3 h-3 ms-2 rtl:rotate-180'
          aria-hidden='true'
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 14 10'>
          <path stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M1 5h12m0 0L9 1m4 4L9 9' />
        </svg>
      </a>
    )
  }
</div>
