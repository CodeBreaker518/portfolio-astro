---
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import { PROJECTS_DATA } from "../data/projects";
import { TAGS } from "../data/tags";

import ExternalLink from "../assets/icons/ExternalLink.astro";
import GitHub from "../assets/icons/GitHub.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projectsList = PROJECTS_DATA[lang];
---

<div class="flex flex-col gap-y-12">
  {
    projectsList.map(({ title, description, tags, image, link, github }) => {
      const isMock = image === "/projects/zendapro.webp" || image === "/projects/goattool.webp" || image === "/projects/tramet.webp";

      return (
        <article class="relative bg-white/[0.02] border border-white/[0.05] rounded-2xl p-6 backdrop-blur-md transition-all duration-300 hover:border-white/15 hover:bg-white/[0.04] shadow-xl shadow-black/20 group">
          <div class="flex flex-col gap-y-6">
            
            <!-- Top: Visual Showcase (Full width) -->
            <div class="relative overflow-hidden rounded-xl border border-white/10 aspect-video w-full bg-black/40">
              {!isMock ? (
                <img
                  class="w-full h-full object-contain bg-black/20 group-hover:scale-[1.01] transition duration-500 ease-out"
                  src={image}
                  alt={`Screenshot of the project ${title}`}
                />
              ) : (
                <div class={`w-full h-full flex items-center justify-center bg-gradient-to-br ${
                  title === "ZendaPro" ? "from-indigo-600 to-purple-900" :
                  title === "Goat Tool" ? "from-amber-600 to-orange-900" :
                  "from-teal-600 to-cyan-950"
                } group-hover:scale-[1.01] transition duration-500 ease-out`}>
                  <span class="text-5xl font-extrabold tracking-widest text-white/20 select-none font-sans">
                    {title.split(' ').map(n => n[0]).join('')}
                  </span>
                </div>
              )}
            </div>

            <!-- Bottom: Details -->
            <div class="flex flex-col gap-y-4">
              <div>
                <h3 class="text-2xl font-bold text-yellow-200 group-hover:text-white transition duration-200 mb-2">{title}</h3>
                <p class="text-sm md:text-base font-normal text-neutral-300 leading-relaxed mb-4 text-pretty" set:html={description} />
                
                <ul class="flex gap-2 flex-row flex-wrap mb-4">
                  {tags.map((tagKey) => {
                    const tag = TAGS[tagKey] || { name: tagKey, class: "bg-gray-500/10 text-gray-200 border border-gray-500/20", icon: null };
                    return (
                      <li>
                        <span class={`flex items-center justify-center gap-x-1.5 rounded-full text-xs ${tag.class} py-1 px-2.5 font-medium`}>
                          {tag.icon && <tag.icon class="h-3.5 w-auto object-contain" />}
                          {tag.name}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>

              <!-- Action Links -->
              <div class="flex flex-wrap gap-4">
                {link && (
                  <a
                    href={link}
                    class="inline-flex items-center gap-x-2 bg-white text-black font-semibold text-xs py-2.5 px-5 rounded-full hover:bg-yellow-200 hover:scale-105 active:scale-95 transition duration-200"
                    target="_blank"
                    rel="noreferrer noopener">
                    <ExternalLink class="size-4" />
                    {t('projects.demo')}
                  </a>
                )}
                
                {github ? (
                  <a
                    href={github}
                    class="inline-flex items-center gap-x-2 bg-white/5 border border-white/10 text-white font-semibold text-xs py-2.5 px-5 rounded-full hover:bg-white/10 hover:scale-105 active:scale-95 transition duration-200"
                    target="_blank"
                    rel="noreferrer noopener">
                    <GitHub class="size-4" />
                    {t('projects.github')}
                  </a>
                ) : (
                  <div class="inline-flex items-center gap-x-2 bg-white/5 border border-white/5 text-neutral-400 font-semibold text-xs py-2.5 px-5 rounded-full cursor-not-allowed opacity-50">
                    <svg class="size-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    {t('projects.private')}
                  </div>
                )}
              </div>
            </div>

          </div>
        </article>
      );
    })
  }
</div>
